# SLEB API (server-side only, never exposed to the browser)
SLEB_BASE_URL=https://sleb.sg/slebapi/beea
SLEB_USERNAME=
SLEB_PASSWORD=

# Set to 1 to return mock results instead of calling SLEB (demo without API access)
SLEB_MOCK=0

# Optional: require this code before anyone can use the app (recommended for public deploys)
ACCESS_CODE=
